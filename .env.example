# Separate staging database. Do not use the live CRM database here.
CONTACT_REVIEW_MONGO_URI=mongodb://127.0.0.1:27017/contact_review
# Optional until you are ready to connect. CRM transfers require a replica set / Atlas.
CRM_MONGO_URI=
REVIEW_ADMIN_EMAIL=admin@example.com
# Set a strong password for this separate application; never commit this file.
REVIEW_ADMIN_PASSWORD=
# Random secret of at least 32 characters.
REVIEW_JWT_SECRET=
PORT=5100
HOST=127.0.0.1
